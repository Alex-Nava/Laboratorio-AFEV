class Ejercicio1
operations
    public Ejercicio1Propuesto : () ==> bool
    Ejercicio1Propuesto() ==
        -- Ejercicio 1: Existe un valor en la lista de números [80, 100, 120, 90, 250] 
        -- tal que el valor está en el rango de 500 y 600 grados de temperatura
        return exists i in set inds [80, 100, 120, 90, 250] & 
               [80, 100, 120, 90, 250](i) >= 500 and [80, 100, 120, 90, 250](i) <= 600;

end Ejercicio1
